{
  "name": "@matematicsolutions/mcp-eu-compliance",
  "version": "0.5.0",
  "description": "Połączony MCP UE: polskie źródła Cellar/TSUE/CELEX/ECLI i lokalny korpus 14 regulacji",
  "main": "dist/index.js",
  "scripts": {
    "test:descriptors": "node test/descriptor-lock.mjs",
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "fetch-corpus": "node scripts/fetch-corpus.mjs",
    "smoke": "node test/smoke.mjs",
    "drift": "node test/drift.mjs",
    "test:conformance": "node test/invalid-args.mjs",
    "test": "npm run build && npm run drift && npm run test:descriptors && npm run test:conformance && npm run test:live-offline && npm run test:unified && npm run smoke",
    "test:live-offline": "node test/live-offline.mjs",
    "test:unified": "node test/unified-contract.mjs",
    "audit:pl-sources": "node scripts/pl-corpus-audit.mjs --json"
  },
  "keywords": [
    "mcp",
    "eu",
    "compliance",
    "eur-lex",
    "gdpr",
    "ai-act",
    "dora",
    "nis2",
    "eidas",
    "cra",
    "legal"
  ],
  "author": "MateMatic / Wieslaw Mazur",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsx": "^4.19.3",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "mcpName": "io.github.matematicsolutions/mcp-eu-compliance",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matematicsolutions/mcp-eu-compliance.git"
  },
  "bin": {
    "mcp-eu-compliance": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
