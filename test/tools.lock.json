    "eu_search": {
      "sha256": "28af21dd7db4ad80fef968af41a2e8ffbb7af0d25b30fdf2fe5cb8e35118f4c8",
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false,
          "readOnlyHint": true
        },
        "description": "Wyszukiwanie pelnotekstowe (FTS5) po tresci artykulow regulacji UE. Zwraca snippety verbatim z podswietleniem trafien. Zakres: 14 regulacji digital/data/cyber (GDPR, AI Act, DORA, NIS2, eIDAS 2.0, CRA, DSA, DMA, Data Act, DGA, LED, ePrivacy, Cybersecurity Act, CER). Bledy: `empty_query` (po normalizacji brak slow), `corpus_error` (blad SQLite).",
        "inputSchema": {
          "properties": {
            "limit": {
              "description": "Maks. liczba trafien (domyslnie 8, max 25).",
              "type": "number"
            },
            "query": {
              "description": "Fraza w jezyku naturalnym, np. 'breach notification timeline'.",
              "type": "string"
            },
            "regulations": {
              "description": "Opcjonalny podzbior regulacji. Brak = wszystkie 6.",
              "items": {
                "enum": [
                  "GDPR",
                  "AI_ACT",
                  "DORA",
                  "NIS2",
                  "EIDAS2",
                  "CRA",
                  "DSA",
                  "DMA",
                  "DATA_ACT",
                  "DGA",
                  "LED",
                  "EPRIVACY",
                  "CYBERSECURITY_ACT",
                  "CER"
                ],
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        },
        "name": "eu_search"
      }
    },
    "search_by_celex": {
      "sha256": "e6c1c1e2aa8be3fb55154fcac8063bfe825da61e9c1b4c2f49014830215e1b95",
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Znajdz akt prawny UE lub orzeczenie CJEU po numerze CELEX. Numer CELEX jest unikalny i identyfikuje dokument niezaleznie od jezyka. Przyklady: 32016R0679 (RODO), 31995L0046 (uchylona dyrektywa o ochronie danych), 62018CJ0311 (wyrok Schrems II). Zwraca polski tytuł (jeśli dostępny), ECLI (dla orzeczeń) i polski adres EUR-Lex.",
        "inputSchema": {
          "properties": {
            "celex": {
              "description": "Numer CELEX, np. '32016R0679' (RODO).",
              "type": "string"
            }
          },
          "required": [
            "celex"
          ],
          "type": "object"
        },
        "name": "search_by_celex"
      }
    },
    "search_by_date_range": {
      "sha256": "7486476f5d7c8e6ad738647631fe82ddbce9ef90b60f9f20f04758d2ec6654a1",
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Znajdz akty prawne UE z zakresu dat (po dacie dokumentu). Opcjonalnie filtruj po typie (REG=rozporzadzenie, DIR=dyrektywa, DEC=decyzja, RECO=zalecenie, OPIN=opinia). Maks. 50 wynikow na zapytanie. Uzyteczne do przegladu aktow z konkretnego okresu legislacyjnego.",
        "inputSchema": {
          "properties": {
            "date_from": {
              "description": "Data od (YYYY-MM-DD).",
              "type": "string"
            },
            "date_to": {
              "description": "Data do (YYYY-MM-DD).",
              "type": "string"
            },
            "document_type": {
              "description": "Skrot typu aktu: REG, DIR, DEC, RECO, OPIN. Pomin zeby objac wszystkie.",
              "enum": [
                "REG",
                "DIR",
                "DEC",
                "RECO",
                "OPIN"
              ],
              "type": "string"
            },
            "limit": {
              "description": "Maks. liczba wynikow (1-50). Domyslnie 20.",
              "maximum": 50,
              "minimum": 1,
              "type": "number"
            }
          },
          "required": [
            "date_from",
            "date_to"
          ],
          "type": "object"
        },
        "name": "search_by_date_range"
      }
    },
    "search_cjeu": {
      "sha256": "e8782fe47ff20cabcaab88ef91383c54bb6c8139c9bf0b7865193b9881367ab2",
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Wyszukaj orzecznictwo Trybunalu Sprawiedliwosci UE (CJEU): wyroki (JUDG), postanowienia (ORDER) i opinie rzecznikow generalnych (OPIN_AG). Opcjonalnie zawez do zakresu dat, typu dokumentu i keyworda w tytule (tytul CJEU zawiera strony sprawy, sygnature i slowa kluczowe wyroku). Zwraca CELEX (np. 62018CJ0311), ECLI, datę wydania, polski tytuł (jeśli dostępny) i adres EUR-Lex PL.",
        "inputSchema": {
          "properties": {
            "date_from": {
              "description": "Data od (YYYY-MM-DD). Opcjonalna.",
              "type": "string"
            },
            "date_to": {
              "description": "Data do (YYYY-MM-DD). Opcjonalna.",
              "type": "string"
            },
            "document_type": {
              "description": "Typ dokumentu: JUDG=wyrok, ORDER=postanowienie, OPIN_AG=opinia rzecznika generalnego. Pomin zeby objac wszystkie trzy.",
              "enum": [
                "JUDG",
                "ORDER",
                "OPIN_AG"
              ],
              "type": "string"
            },
            "limit": {
              "description": "Maks. liczba wynikow (1-50). Domyslnie 20.",
              "maximum": 50,
              "minimum": 1,
              "type": "number"
            },
            "query": {
              "description": "Keyword wyszukiwany w tytule orzeczenia (case-insensitive), np. 'personal data' albo 'Schrems'. Opcjonalny.",
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "name": "search_cjeu"
      }
    },
    "search_cjeu_by_ecli": {
      "sha256": "124c788ec00dad9496313cb3f3deac406b14489697c0a1009caeef790bb7b9b4",
      "descriptor": {
