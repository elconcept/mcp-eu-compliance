  "tools": {
    "eu_article": {
      "sha256": "238839babe3a1324c2ffaa0bec96c1939662e366574396110f1b2aff565dccb5",
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false,
          "readOnlyHint": true
        },
        "description": "Pelny tekst artykulu (verbatim) po identyfikatorze regulacji i numerze artykulu, wraz z tytulem i rozdzialem. Bledy: `out_of_scope` (regulacja poza 6 ICP), `missing_arg` (brak article_number), `not_found` (artykul/regulacja nie ma w snapshot).",
        "inputSchema": {
          "properties": {
            "article_number": {
              "description": "Numer artykulu, np. '33' (GDPR), '6' (AI Act).",
              "type": "string"
            },
            "regulation": {
              "enum": [
                "GDPR",
                "AI_ACT",
                "DORA",
                "NIS2",
                "EIDAS2",
                "CRA",
                "DSA",
                "DMA",
                "DATA_ACT",
                "DGA",
                "LED",
                "EPRIVACY",
                "CYBERSECURITY_ACT",
                "CER"
              ],
              "type": "string"
            }
          },
          "required": [
            "regulation",
            "article_number"
          ],
          "type": "object"
        },
        "name": "eu_article"
      }
    },
    "eu_check_applicability": {
      "sha256": "99ef8b584ee31f94242d56af3108008b5665508a9a9707412a2aceba50a96d3c",
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false,
          "readOnlyHint": true
        },
        "description": "Ktore z 14 regulacji UE dotycza danego sektora (i opcjonalnie podsektora). Zwraca reguly stosowalnosci z poziomem pewnosci i artykulem-podstawa. To wskazowka ekspercka, nie wiazaca ocena prawna. Bledy: `missing_arg` (brak sector), `corpus_error`.",
        "inputSchema": {
          "properties": {
            "sector": {
              "enum": [
                "digital_infrastructure",
                "energy",
                "financial",
                "healthcare",
                "manufacturing",
                "public_administration",
                "transport",
                "other"
              ],
              "type": "string"
            },
            "subsector": {
              "description": "Opcjonalny podsektor (np. 'bank', 'insurance').",
              "type": "string"
            }
          },
          "required": [
            "sector"
          ],
          "type": "object"
        },
        "name": "eu_check_applicability"
      }
    },
    "eu_compare": {
      "sha256": "32e324c73ca8906e1de44ca3668c80cc38a91833926423d9dbdde05ef29fd8a8",
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false,
          "readOnlyHint": true
        },
        "description": "Porownanie tego samego zagadnienia w kilku regulacjach naraz. Dla kazdej regulacji zwraca najlepiej pasujacy artykul (snippet verbatim). Np. obowiazek zgloszenia incydentu w DORA vs NIS2 vs CRA. Bledy: `empty_query`, `corpus_error`.",
        "inputSchema": {
          "properties": {
            "query": {
              "description": "Zagadnienie do porownania.",
              "type": "string"
            },
            "regulations": {
              "description": "Regulacje do porownania (min. 2). Brak = wszystkie 6.",
              "items": {
                "enum": [
                  "GDPR",
                  "AI_ACT",
                  "DORA",
                  "NIS2",
                  "EIDAS2",
                  "CRA",
                  "DSA",
                  "DMA",
                  "DATA_ACT",
                  "DGA",
                  "LED",
                  "EPRIVACY",
                  "CYBERSECURITY_ACT",
                  "CER"
                ],
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        },
        "name": "eu_compare"
      }
    },
    "eu_evidence": {
      "sha256": "78b74a863dc3bee2fd70487698fe0e4006c47f9e54e743101030db887b6a39a0",
      "descriptor": {
        "annotations": {
